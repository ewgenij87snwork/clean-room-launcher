{
  "schema_version": "clroom.release-contract.v1",
  "baseline_source": "latest_published_github_release",
  "always_required_gates": [
    "full_delta_audit",
    "release_contract_review",
    "strategic_alignment",
    "public_boundary",
    "release_identity",
    "owner_tag_gate",
    "draft_release_review",
    "owner_publish_gate",
    "immutable_release_verify",
    "post_publish_install_verify"
  ],
  "rules": [
    {
      "id": "runtime",
      "patterns": [
        "src/**"
      ],
      "required_gates": [
        "full_locked_tests",
        "codeql"
      ]
    },
    {
      "id": "security_boundary",
      "patterns": [
        "src/adapters/**",
        "src/cli/**",
        "src/catalog/**"
      ],
      "required_gates": [
        "negative_security_tests",
        "full_locked_tests",
        "codeql"
      ]
    },
    {
      "id": "claude_plugin_activation",
      "patterns": [
        "src/adapters/claude/activation.rs",
        "src/adapters/claude/isolation.rs",
        "src/adapters/claude/plugin_state.rs",
        "src/catalog/plugin_surface.rs",
        "src/catalog/provider_inventory.rs",
        "src/catalog/resource.rs",
        "src/catalog/selection.rs",
        "src/cli/info.rs",
        "src/cli/launch_contract.rs",
        "src/cli/mod.rs",
        "src/cli/resource_options.rs"
      ],
      "required_gates": [
        "real_provider_baseline",
        "draft_artifact_plugin_activation_e2e"
      ]
    },
    {
      "id": "dependencies",
      "patterns": [
        "Cargo.toml",
        "Cargo.lock",
        "deny.toml"
      ],
      "required_gates": [
        "dependency_sca",
        "dependency_review",
        "sbom_provenance"
      ]
    },
    {
      "id": "release_system",
      "patterns": [
        ".github/workflows/release*.yml",
        "scripts/release/**",
        "packaging/**",
        "release/reviews/**"
      ],
      "required_gates": [
        "release_readiness",
        "artifact_integrity",
        "sbom_provenance",
        "release_contract_review"
      ]
    },
    {
      "id": "ci",
      "patterns": [
        ".github/workflows/**"
      ],
      "required_gates": [
        "ci_workflow_review",
        "codeql"
      ]
    },
    {
      "id": "tests",
      "patterns": [
        "tests/**",
        "fixtures/**",
        "fuzz/**"
      ],
      "required_gates": [
        "full_locked_tests"
      ]
    },
    {
      "id": "public_claims",
      "patterns": [
        "README.md",
        "SECURITY.md",
        "CHANGELOG.md",
        "docs/**"
      ],
      "required_gates": [
        "release_notes_reconciliation",
        "public_boundary"
      ]
    },
    {
      "id": "discovery",
      "patterns": [
        "docs/_config.yml",
        "docs/robots.txt",
        "docs/sitemap.xml"
      ],
      "required_gates": [
        "docs_discovery_contract"
      ]
    },
    {
      "id": "installer",
      "patterns": [
        "install.sh",
        "docs/install.md"
      ],
      "required_gates": [
        "installer_self_test"
      ]
    }
  ],
  "gate_phases": {
    "pre_tag": [
      "ci_workflow_review",
      "codeql",
      "dependency_review",
      "dependency_sca",
      "docs_discovery_contract",
      "full_delta_audit",
      "full_locked_tests",
      "installer_self_test",
      "negative_security_tests",
      "public_boundary",
      "real_provider_baseline",
      "release_contract_review",
      "release_identity",
      "release_notes_reconciliation",
      "release_readiness",
      "strategic_alignment",
      "owner_tag_gate"
    ],
    "tag_workflow": [
      "artifact_integrity",
      "sbom_provenance"
    ],
    "pre_publish": [
      "draft_artifact_plugin_activation_e2e",
      "draft_release_review",
      "owner_publish_gate"
    ],
    "post_publish": [
      "immutable_release_verify",
      "post_publish_install_verify"
    ]
  }
}
